   "source": [
    "# Fetch Microsoft stock data for the same date range\n",
    "msft = yf.download(\"MSFT\", start=df_grouped.index.min(), end=df_grouped.index.max())\n",
    "\n",
    "# Scale the Microsoft price data\n",
